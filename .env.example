# Public client configuration only. Never put service-role keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# MediBot AI Assistant (optional — enables external Gemini LLM responses)
# WARNING: VITE_ prefix means this value IS exposed in frontend JS bundles.
# For production, set GEMINI_API_KEY in Supabase Edge Function secrets instead.
# The local RAG engine still works without this key set.
VITE_GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY

# Configure provider secrets in Supabase Edge Function secrets, not frontend env vars:
# GEMINI_API_KEY=         (used by medibot-ai-proxy edge function, set via: supabase secrets set GEMINI_API_KEY=...)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMS_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_SECRET=
